# BikePower C 环境变量示例
# 复制为 .env 并填入实际值

# Gitee Token（用于创建 Release/打 tag）
# 生成地址: https://gitee.com/profile/personal_access_tokens
GITEE_TOKEN=your_gitee_token_here

# 串口设备（可选，自动扫描时不需要）
ESP_PORT=/dev/cu.usbmodem101

# ESP-IDF 路径（可选，默认 ~/esp/esp-idf-v5.5.4）
IDF_PATH=$HOME/esp/esp-idf-v5.5.4

# 构建目标
ESP_TARGET=esp32c3
